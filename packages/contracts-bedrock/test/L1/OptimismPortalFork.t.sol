pragma solidity 0.8.15;

import { OptimismPortal } from "src/L1/OptimismPortal.sol";
import { L2OutputOracle } from "src/L1/L2OutputOracle.sol";
import { SystemConfig } from "src/L1/SystemConfig.sol";
import { StandardBridge } from "src/universal/StandardBridge.sol";
import { CrossDomainMessenger } from "src/universal/CrossDomainMessenger.sol";
import { Types } from "src/libraries/Types.sol";
import { Test } from "forge-std/Test.sol";
import { console } from "forge-std/console.sol";

interface IERC20 {
    function balanceOf(address account) external view returns (uint256);
}

contract OptimismPortalFork_Test is Test {
    address public l2OutputOracle = 0xE6f24d2C32B3109B18ed33cF08eFb490b1e09C10;
    address public systemConfig = 0x80e73D6BfC73c567032304C3891a06c2d9954d09;
    address public portal = 0x6A12432491bbbE8d3babf75F759766774C778Db4;
    address public rss3 = 0xc98D64DA73a6616c42117b582e832812e7B8D57F;
    address public operator = 0xC4f81F990b47c12144e74A901162A2cFDf4b5a9d;

    address public beneficiary = 0x66C0f77D98f86aC350B0E3349C1EAafA13FF2a6C;

    function setUp() public {
        vm.createSelectFork(
            "https://ethereum.blockpi.network/v1/rpc/ccda07fa41067b224b38b4db9fe6a5f990887fe6", 21018315
        );

        L2OutputOracle l2OutputOracle_ = L2OutputOracle(l2OutputOracle);
        SystemConfig systemConfig_ = SystemConfig(systemConfig);
        OptimismPortal p = new OptimismPortal(l2OutputOracle_, systemConfig_, operator);
        vm.etch(portal, address(p).code);
    }

    function testFinalizeWithdrawalTransactionWithFork() public {
        // data from prove tx:
        // https://etherscan.io/tx/0x95ac5033949bf907339156a29bc59ef137f6151223fabfca2851565f7f31a436
        Types.WithdrawalTransaction memory withdrawalTx = Types.WithdrawalTransaction({
            nonce: 1766847064778384329583297500742918515827483896875618958121606201292620122,
            sender: 0x4200000000000000000000000000000000000007,
            target: 0x892CAa506c86C5101f5eC11C6f09589c9dC8A85C,
            value: 0,
            gasLimit: 491822,
            data: hex""
        });

        // decode relayMessage(uint256,address,address,uint256,uint256,bytes)
        (
            uint256 msgNonce,
            address msgSender,
            address msgTarget,
            uint256 msgValue,
            uint256 msgMinGasLimit,
            bytes memory msgMessage
        ) = abi.decode(
            slice(withdrawalTx.data, 4, withdrawalTx.data.length - 4),
            (uint256, address, address, uint256, uint256, bytes)
        );
        // decode finalizeBridgeERC20(address,address,address,address,uint256,bytes)
        (address l2Token, address l1Token, address from, address to, uint256 amount, bytes memory extraData) = abi
            .decode(slice(msgMessage, 4, msgMessage.length - 4), (address, address, address, address, uint256, bytes));

        // replace `to` with `beneficiary`
        to = beneficiary;
        bytes memory newTxData = abi.encodeWithSelector(
            CrossDomainMessenger.relayMessage.selector,
            msgNonce,
            msgSender,
            msgTarget,
            msgValue,
            msgMinGasLimit,
            abi.encodeWithSelector(
                StandardBridge.finalizeBridgeERC20.selector, l2Token, l1Token, from, to, amount, extraData
            )
        );

        uint256 balanceBefore = IERC20(rss3).balanceOf(beneficiary);

        // call finalizeWithdrawalTransaction by operator
        bytes memory data = abi.encodeWithSignature(
            "finalizeWithdrawalTransaction((uint256,address,address,uint256,uint256,bytes),bytes)",
            withdrawalTx,
            newTxData
        );
        console.log("calldata:");
        console.logBytes(data);
        vm.prank(operator);
        (bool success,) = portal.call(data);
        assertTrue(success);

        // check balance of rss3
        uint256 balanceAfter = IERC20(rss3).balanceOf(beneficiary);
        assertEq(balanceAfter - balanceBefore, 2229261 ether);
    }

    function testFinalizeWithdrawalTransactionFailWithFork() public {
        bytes memory data =
            hex"";

        // case 1: call by anyone other than operator will fail
        vm.prank(0xb692E9E7394484eeF0e460905F2C25B31A7687B1);
        (bool success,) = portal.call(data);
        assertTrue(success);

        // case 2: call twice will fail
        vm.prank(operator);
        (success,) = portal.call(data);

        // call original finalizeWithdrawalTransaction
        Types.WithdrawalTransaction memory withdrawalTx = Types.WithdrawalTransaction({
            nonce: 1766847064778384329583297500742918515827483896875618958121606201292620122,
            sender: 0x4200000000000000000000000000000000000007,
            target: 0x892CAa506c86C5101f5eC11C6f09589c9dC8A85C,
            value: 0,
            gasLimit: 491822,
            data: hex""
        });
        bytes memory txData = abi.encodeWithSignature(
            "finalizeWithdrawalTransaction((uint256,address,address,uint256,uint256,bytes))", withdrawalTx
        );
        skip(2 days);
        vm.prank(operator);
        (success,) = portal.call(txData);
        assertFalse(success);
    }

    function slice(bytes memory data, uint256 start, uint256 length) internal pure returns (bytes memory) {
        bytes memory result = new bytes(length);
        for (uint256 i = 0; i < length; i++) {
            result[i] = data[i + start];
        }
        return result;
    }
}
